# ---------------------------------------------------------------------------
# Adv-D-ToC-KB -- copy to .env and edit before running `make up`.
# ---------------------------------------------------------------------------

# --- REQUIRED ---------------------------------------------------------------
TOCKB_OPENAI_API_KEY=sk-...
POSTGRES_PASSWORD=change-me-in-production

# --- STRONGLY RECOMMENDED (leave empty for dev-only public admin routes) ----
TOCKB_ADMIN_TOKEN=

# --- Tree behaviour ---------------------------------------------------------
TOCKB_MAX_DEPTH=5
TOCKB_MAX_ALIAS_HOPS=3
TOCKB_MAX_TOKENS_PER_NODE=50000
TOCKB_MAX_VARIANCE_THRESHOLD=0.75
TOCKB_SIMILARITY_THRESHOLD=0.65
TOCKB_MAX_DEPTH_STRATEGY=spillover   # spillover | pivot

# --- Restructure / audit ----------------------------------------------------
TOCKB_KMEANS_MAX_CLUSTERS=7
TOCKB_AUDIT_INTERVAL_DAYS=30
TOCKB_AUDIT_SAMPLE_SIZE=10
TOCKB_AUDIT_BATCH_SIZE=100
TOCKB_ALIAS_DISCOVERY_ENABLED=true
TOCKB_ALIAS_SIMILARITY_THRESHOLD=0.80

# --- Models -----------------------------------------------------------------
TOCKB_EMBEDDING_MODEL=text-embedding-3-large
TOCKB_EMBEDDING_DIMENSIONS=1536
TOCKB_LLM_MODEL=gpt-4o-mini

# --- Logging ----------------------------------------------------------------
TOCKB_LOG_LEVEL=INFO        # DEBUG | INFO | WARNING | ERROR
TOCKB_LOG_FORMAT=json       # json | text

# --- Frontend ---------------------------------------------------------------
VITE_API_BASE=http://localhost:8000
